# ========================================================
# CineWeb Backend — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores.
# ========================================================

# URL de conexão ao PostgreSQL (banco do Docker exposto na porta 5433 do PC)
DATABASE_URL=postgresql://postgres:60451@localhost:5433/cineweb?schema=public

# Chave secreta para assinar Access Tokens JWT (15min)
# Em produção, use uma chave longa e aleatória!
JWT_SECRET=cineweb-jwt-secret-dev-2026

# Chave secreta para assinar Refresh Tokens JWT (7 dias)
JWT_REFRESH_SECRET=cineweb-jwt-refresh-secret-dev-2026

# Porta do servidor
PORT=3000

# Brokers do Kafka (fora do Docker: localhost:9094 | dentro do Docker: kafka:9092)
KAFKA_BROKERS=localhost:9094
